# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
MONGODB_URI=mongodb://localhost:27017/cts
MONGODB_TEST_URI=mongodb://localhost:27017/cts_test

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:5173

# Email Configuration (optional - if not set, emails won't be sent)
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=cts.crete@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=Comfort Transfer Services <cts.crete@gmail.com>

# Admin Notifications (comma-separated για πολλαπλούς παραλήπτες)
ADMIN_EMAIL=giannis2001.gs@gmail.com,cts.crete@gmail.com

